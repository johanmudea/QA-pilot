# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

# --- Test framework ---
BASE_URL=https://the-internet.herokuapp.com
HEADLESS=true
DEFAULT_TIMEOUT=10000

# --- Azure DevOps (deterministic write/read layer, see rules/azure-policy.md) ---
# Org URL, e.g. https://dev.azure.com/your-organization
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PROJECT=
# Personal Access Token with: Work Items (Read & Write), Test Management (Read & Write),
# Code (Read & Write) for the qa:open-pr branch/PR flow
AZURE_DEVOPS_PAT=
# Name of the Azure Repos repository (not the project) to open PRs against
AZURE_DEVOPS_REPO=
# Default/base branch PRs target — defaults to "main" if unset
AZURE_DEVOPS_DEFAULT_BRANCH=main
